-- =====================================================================================================
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'storage' AND table_name = 'buckets') THEN
        INSERT INTO storage.buckets (id, name, public)
        VALUES
            ('salon-media', 'salon-media', true),
            ('avatars', 'avatars', true),
            ('documents', 'documents', true)
        ON CONFLICT (id) DO UPDATE SET public = true;
    END IF;
EXCEPTION WHEN OTHERS THEN NULL;
END $$;

DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema = 'storage' AND table_name = 'objects') THEN
        DROP POLICY IF EXISTS "Public_Read_Storage_Vagou" ON storage.objects;
        DROP POLICY IF EXISTS "Public_Write_Storage_Vagou" ON storage.objects;
        DROP POLICY IF EXISTS "Public_Update_Storage_Vagou" ON storage.objects;
        DROP POLICY IF EXISTS "Public_Delete_Storage_Vagou" ON storage.objects;

        CREATE POLICY "Public_Read_Storage_Vagou" ON storage.objects FOR SELECT USING (bucket_id IN ('salon-media', 'avatars', 'documents'));
        CREATE POLICY "Public_Write_Storage_Vagou" ON storage.objects FOR INSERT WITH CHECK (bucket_id IN ('salon-media', 'avatars', 'documents'));
        CREATE POLICY "Public_Update_Storage_Vagou" ON storage.objects FOR UPDATE USING (bucket_id IN ('salon-media', 'avatars', 'documents'));
        CREATE POLICY "Public_Delete_Storage_Vagou" ON storage.objects FOR DELETE USING (bucket_id IN ('salon-media', 'avatars', 'documents'));
    END IF;
EXCEPTION WHEN OTHERS THEN NULL;
END $$;

