-- 4.5 Trigger de Espelhamento Bidirecional: services ⇄ salon_services
-- Qualquer serviço criado no Meu Negócio (salon_services) reflete instantaneamente em services (Admin/Portal) e vice-versa!
CREATE OR REPLACE FUNCTION public.sync_services_bidirectional()
RETURNS TRIGGER AS $$
DECLARE
    v_label VARCHAR(255);
BEGIN
    IF pg_trigger_depth() > 1 THEN
        RETURN COALESCE(NEW, OLD);
    END IF;

    IF TG_OP = 'DELETE' THEN
        IF TG_TABLE_NAME = 'services' THEN
            DELETE FROM public.salon_services WHERE id = OLD.id OR service_id = OLD.id;
        ELSIF TG_TABLE_NAME = 'salon_services' THEN
            DELETE FROM public.services WHERE id = OLD.id OR id = OLD.service_id;
        END IF;
        RETURN OLD;
    END IF;

    v_label := COALESCE(NEW.name, NEW.title, NEW.custom_name, 'Procedimento');
    NEW.name := v_label;
    NEW.title := v_label;
    NEW.custom_name := COALESCE(NEW.custom_name, v_label);

    IF TG_TABLE_NAME = 'services' THEN
        INSERT INTO public.salon_services (
            id, salon_id, service_id, name, title, custom_name, category, price, promotional_price,
            duration_minutes, commission_rate, description, image_url, photos, videos, slides,
            target_audience, order_index, is_active, created_at, updated_at
        ) VALUES (
            NEW.id, NEW.salon_id, NEW.id, NEW.name, NEW.title, NEW.custom_name, NEW.category, NEW.price, NEW.promotional_price,
            NEW.duration_minutes, NEW.commission_rate, NEW.description, NEW.image_url, NEW.photos, NEW.videos, NEW.slides,
            NEW.target_audience, NEW.order_index, NEW.is_active, NEW.created_at, NOW()
        )
        ON CONFLICT (id) DO UPDATE SET
            salon_id = EXCLUDED.salon_id,
            name = EXCLUDED.name,
            title = EXCLUDED.title,
            custom_name = EXCLUDED.custom_name,
            category = EXCLUDED.category,
            price = EXCLUDED.price,
            promotional_price = EXCLUDED.promotional_price,
            duration_minutes = EXCLUDED.duration_minutes,
            commission_rate = EXCLUDED.commission_rate,
            description = EXCLUDED.description,
            image_url = EXCLUDED.image_url,
            photos = EXCLUDED.photos,
            videos = EXCLUDED.videos,
            slides = EXCLUDED.slides,
            target_audience = EXCLUDED.target_audience,
            order_index = EXCLUDED.order_index,
            is_active = EXCLUDED.is_active,
            updated_at = NOW();
    ELSIF TG_TABLE_NAME = 'salon_services' THEN
        INSERT INTO public.services (
            id, salon_id, name, title, custom_name, category, price, promotional_price,
            duration_minutes, commission_rate, description, image_url, photos, videos, slides,
            target_audience, order_index, is_active, created_at, updated_at
        ) VALUES (
            NEW.id, NEW.salon_id, NEW.name, NEW.title, NEW.custom_name, NEW.category, NEW.price, NEW.promotional_price,
            NEW.duration_minutes, NEW.commission_rate, NEW.description, NEW.image_url, NEW.photos, NEW.videos, NEW.slides,
            NEW.target_audience, NEW.order_index, NEW.is_active, NEW.created_at, NOW()
        )
        ON CONFLICT (id) DO UPDATE SET
            salon_id = EXCLUDED.salon_id,
            name = EXCLUDED.name,
            title = EXCLUDED.title,
            custom_name = EXCLUDED.custom_name,
            category = EXCLUDED.category,
            price = EXCLUDED.price,
            promotional_price = EXCLUDED.promotional_price,
            duration_minutes = EXCLUDED.duration_minutes,
            commission_rate = EXCLUDED.commission_rate,
            description = EXCLUDED.description,
            image_url = EXCLUDED.image_url,
            photos = EXCLUDED.photos,
            videos = EXCLUDED.videos,
            slides = EXCLUDED.slides,
            target_audience = EXCLUDED.target_audience,
            order_index = EXCLUDED.order_index,
            is_active = EXCLUDED.is_active,
            updated_at = NOW();
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

