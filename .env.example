# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Public Browser Config (Auth JWT + Realtime + Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-Side Privileged Key (NEVER expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Native Web Push (VAPID Keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@vagouapp.com

# Optional Initial Super Admin Bootstrap (server-side only, used once when system_admins is empty)
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_USERNAME=
INITIAL_SUPER_ADMIN_PASSWORD=

# Google Maps Platform (Routes API v2, Places API New, Maps JavaScript API, Geocoding API, Roads API)
VITE_GOOGLE_MAPS_API_KEY=
